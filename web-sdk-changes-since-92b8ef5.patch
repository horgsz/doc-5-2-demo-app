+++ b/src/core/lib/Orientation.spec.ts
@@ -0,0 +1,72 @@
+/**
+ * Orientation where screen.orientation does not exist (Safari before 16.4).
+ *
+ * Found by the simulator: with no screen.orientation the scan threw twice --
+ * on the listener and on reading .type -- and never got past its intro.
+ */
+import { onScreenOrientationChange, readScreenOrientation } from './Orientation';
+
+// the spec environment has a window but no screen
+if (typeof (global as any).screen === 'undefined') (global as any).screen = {};
+
+function setScreenOrientation(value: any) {
+  Object.defineProperty((global as any).screen, 'orientation', { value, configurable: true });
+}
+function setWindowOrientation(value: any) {
+  Object.defineProperty(window, 'orientation', { value, configurable: true });
+}
+
+describe('readScreenOrientation()', () => {
+  afterEach(() => {
+    setScreenOrientation(undefined);
+    setWindowOrientation(undefined);
+  });
+
+  it('uses screen.orientation where there is one', () => {
+    setScreenOrientation({ type: 'landscape-secondary', angle: 270, addEventListener: jest.fn() });
+    expect(readScreenOrientation()).toEqual({ type: 'landscape-secondary', angle: 270 });
+  });
+
+  it('falls back to window.orientation without it (old Safari)', () => {
+    setScreenOrientation(undefined);
+    setWindowOrientation(0);
+    expect(readScreenOrientation()).toEqual({ type: 'portrait-primary', angle: 0 });
+    setWindowOrientation(90);
+    expect(readScreenOrientation()).toEqual({ type: 'landscape-primary', angle: 90 });
+    setWindowOrientation(-90);
+    expect(readScreenOrientation()).toEqual({ type: 'landscape-secondary', angle: 270 });
+  });
+
+  it('falls back to the media query when neither exists -- a desktop, landscape at its natural 0 degrees', () => {
+    setScreenOrientation(undefined);
+    setWindowOrientation(undefined);
+    const mm = window.matchMedia;
+    (window as any).matchMedia = jest.fn(() => ({ matches: true }));
+    expect(readScreenOrientation()).toEqual({ type: 'landscape-primary', angle: 0 });
+    (window as any).matchMedia = mm;
+  });
+});
+
+describe('onScreenOrientationChange()', () => {
+  afterEach(() => setScreenOrientation(undefined));
+
+  it('listens on screen.orientation where there is one', () => {
+    const so = { type: 'portrait-primary', angle: 0, addEventListener: jest.fn(), removeEventListener: jest.fn() };
+    setScreenOrientation(so);
+    const stop = onScreenOrientationChange(() => {});
+    expect(so.addEventListener).toHaveBeenCalledWith('change', expect.any(Function));
+    stop();
+    expect(so.removeEventListener).toHaveBeenCalled();
+  });
+
+  it('listens for orientationchange without it', () => {
+    setScreenOrientation(undefined);
+    const listener = jest.fn();
+    const stop = onScreenOrientationChange(listener);
+    window.dispatchEvent(new Event('orientationchange'));
+    expect(listener).toHaveBeenCalledTimes(1);
+    stop();
+    window.dispatchEvent(new Event('orientationchange'));
+    expect(listener).toHaveBeenCalledTimes(1);
+  });
+});
diff --git a/src/core/lib/Orientation.ts b/src/core/lib/Orientation.ts
new file mode 100644
index 000000000..89a198aa7
--- /dev/null
+++ b/src/core/lib/Orientation.ts
@@ -0,0 +1,51 @@
+/**
+ * Screen orientation that also works where `screen.orientation` does not
+ * exist: Safari before 16.4, which is inside the SDK's iOS 15 support floor.
+ * Reaching for `screen.orientation.type` there threw, and the scan never got
+ * past its intro. The legacy `window.orientation` angle and its
+ * `orientationchange` event stand in for it.
+ */
+export interface ScreenOrientationReading {
+  /** 'portrait-primary' | 'portrait-secondary' | 'landscape-primary' | 'landscape-secondary' */
+  type: string;
+  /** Degrees: 0, 90, 180 or 270. */
+  angle: number;
+}
+
+export function readScreenOrientation(): ScreenOrientationReading {
+  const current = typeof screen !== 'undefined' ? (screen as any).orientation : undefined;
+  if (current && typeof current.type === 'string') {
+    return { type: current.type, angle: current.angle ?? 0 };
+  }
+
+  // window.orientation runs (-90, 180]; -90 is screen.orientation's 270.
+  const legacy = typeof window !== 'undefined' ? (window as any).orientation : undefined;
+  if (typeof legacy === 'number') {
+    const angle = (legacy + 360) % 360;
+    const type =
+      angle === 90 ? 'landscape-primary'
+      : angle === 270 ? 'landscape-secondary'
+      : angle === 180 ? 'portrait-secondary'
+      : 'portrait-primary';
+    return { type, angle };
+  }
+
+  // Neither API: not a phone (iOS has window.orientation, Android
+  // screen.orientation) but a desktop, whose landscape is its natural
+  // orientation -- angle 0, as screen.orientation reports it there. 90 read
+  // as a phone held sideways and turned the portrait-only screens.
+  const landscape = typeof window !== 'undefined' && !!window.matchMedia?.('(orientation: landscape)').matches;
+  return landscape ? { type: 'landscape-primary', angle: 0 } : { type: 'portrait-primary', angle: 0 };
+}
+
+/** Calls `listener` on every orientation change; returns the unsubscribe. */
+export function onScreenOrientationChange(listener: () => void): () => void {
+  const current = typeof screen !== 'undefined' ? (screen as any).orientation : undefined;
+  if (current && typeof current.addEventListener === 'function') {
+    current.addEventListener('change', listener);
+    return () => current.removeEventListener('change', listener);
+  }
+
+  window.addEventListener('orientationchange', listener);
+  return () => window.removeEventListener('orientationchange', listener);
+}
diff --git a/src/core/lib/Scanner.spec.ts b/src/core/lib/Scanner.spec.ts
new file mode 100644
index 000000000..bd796214a
--- /dev/null
+++ b/src/core/lib/Scanner.spec.ts
@@ -0,0 +1,281 @@
+/**
+ * Regression guard for the semi-auto capture quiesce.
+ *
+ * During a capture the engine reads the frame while the live preview competes
+ * for CPU, so capture() disables the camera TRACK to relieve that. It must NOT
+ * pause()/play() the video element: startScanning wires videoFeed.onplay to
+ * onStart(), which resets the semi-auto UI to the front side -- so a play() on
+ * every capture made the shutter reappear and the label flip to "scan front of
+ * ID" mid flip-to-back animation. This locks that in.
+ */
+import { Scanner } from './Scanner';
+import { Camera } from './Camera';
+import { CameraResolution, CameraType, CaptureMode } from './Enums';
+import { ErrorCode } from './SdkError';
+import { RecorderStrategy } from './SessionRecorder';
+import { RecognizerState } from '../recognizers/Recognizer';
+
+// jsdom has no ImageData constructor; capture() builds one.
+if (typeof (global as any).ImageData === 'undefined') {
+  (global as any).ImageData = class {
+    data: any;
+    width: number;
+    height: number;
+    constructor(data: any, width: number, height: number) {
+      this.data = data;
+      this.width = width;
+      this.height = height;
+    }
+  };
+}
+
+/** Minimal `this` for Scanner.prototype.capture.call() -- no real camera/worker. */
+function fakeScanner(track: any) {
+  const videoFeed = {
+    srcObject: { getVideoTracks: () => [track] },
+    pause: jest.fn(),
+    play: jest.fn().mockResolvedValue(undefined),
+  };
+  const self: any = {
+    recognizer: { processImage: jest.fn().mockResolvedValue(RecognizerState.Empty) },
+    videoFeed,
+    capturing: false,
+    shouldStopScanning: false,
+    currentImage: null,
+    currentRecognizerState: RecognizerState.Empty,
+    onCaptureAccepted: null,
+    stop: jest.fn(),
+  };
+  return { self, videoFeed };
+}
+
+describe('Scanner.capture() -- quiesce the camera without touching playback', () => {
+  beforeEach(() => {
+    jest.spyOn(Camera, 'getImageData').mockReturnValue({
+      imageData: { data: new Uint8ClampedArray(4), width: 1, height: 1 },
+    } as any);
+  });
+
+  afterEach(() => jest.restoreAllMocks());
+
+  it('NEVER pauses or plays the video element', async () => {
+    const { self, videoFeed } = fakeScanner({ enabled: true });
+    await Scanner.prototype.capture.call(self);
+
+    expect(videoFeed.pause).not.toHaveBeenCalled();
+    expect(videoFeed.play).not.toHaveBeenCalled();
+  });
+
+  it('disables the track for the read and re-enables it afterwards', async () => {
+    const log: boolean[] = [];
+    const track: any = {};
+    Object.defineProperty(track, 'enabled', {
+      get: () => true,
+      set: (v: boolean) => log.push(v),
+    });
+    const { self } = fakeScanner(track);
+
+    await Scanner.prototype.capture.call(self);
+
+    // down while the engine reads, back up in the finally
+    expect(log).toEqual([false, true]);
+  });
+
+  it('re-enables the track even if the engine read throws', async () => {
+    const log: boolean[] = [];
+    const track: any = {};
+    Object.defineProperty(track, 'enabled', {
+      get: () => true,
+      set: (v: boolean) => log.push(v),
+    });
+    const { self } = fakeScanner(track);
+    self.recognizer.processImage = jest.fn().mockRejectedValue(new Error('boom'));
+
+    await expect(Scanner.prototype.capture.call(self)).rejects.toThrow('boom');
+    expect(log[log.length - 1]).toBe(true); // finally re-enabled it
+  });
+});
+
+/**
+ * TEMP (dynamic-resolution capture). When the capture resolution is higher than
+ * the preview's, capture() must raise the track for the single grab (waiting
+ * until the feed delivers it) and drop it straight back -- so a memory-safe
+ * 1080p preview still yields a 4K still on older iPhones. When they match, it
+ * must not touch the track resolution at all (the previous behaviour).
+ */
+describe('Scanner.capture() -- dynamic-resolution capture', () => {
+  beforeEach(() => {
+    jest.spyOn(Camera, 'getImageData').mockReturnValue({
+      imageData: { data: new Uint8ClampedArray(4), width: 1, height: 1 },
+    } as any);
+  });
+
+  afterEach(() => jest.restoreAllMocks());
+
+  it('bumps the track to the capture resolution for the grab, then restores it', async () => {
+    const calls: Array<[number, boolean]> = [];
+    jest
+      .spyOn(Camera, 'setTrackWidth')
+      .mockImplementation(async (_feed: any, width: number, wait: boolean = false) => {
+        calls.push([width, wait]);
+      });
+
+    const { self } = fakeScanner({ enabled: true });
+    self.dynamicCapture = true;
+    self.captureResolution = CameraResolution.UHD; // 3840
+    self.previewResolution = CameraResolution.FULL_HD; // 1920
+
+    await Scanner.prototype.capture.call(self);
+
+    // First a WAITED bump to the 4K width...
+    expect(calls[0]).toEqual([3840, true]);
+    // ...then (at least) one un-waited restore back to the 1080p width.
+    expect(calls.some(([w, wait]) => w === 1920 && wait === false)).toBe(true);
+  });
+
+  it('leaves the track resolution untouched when preview and capture match', async () => {
+    const spy = jest.spyOn(Camera, 'setTrackWidth').mockResolvedValue();
+    const { self } = fakeScanner({ enabled: true });
+    self.dynamicCapture = false;
+
+    await Scanner.prototype.capture.call(self);
+
+    expect(spy).not.toHaveBeenCalled();
+  });
+});
+
+/**
+ * dynamicCapture ranks resolutions by pixel width, not the enum ordinal -- the
+ * enum is not monotonic since QHD (2560, "2K") is appended after UHD (3840).
+ */
+describe('Scanner.dynamicCapture -- ranks by width, not enum ordinal', () => {
+  const getter = Object.getOwnPropertyDescriptor(Scanner.prototype, 'dynamicCapture')!.get!;
+  const isDynamic = (preview: CameraResolution, capture: CameraResolution): boolean =>
+    getter.call({ previewResolution: preview, captureResolution: capture } as any);
+
+  it('1080p preview + 4K capture is dynamic (a real bump)', () => {
+    expect(isDynamic(CameraResolution.FULL_HD, CameraResolution.UHD)).toBe(true);
+  });
+
+  it('4K preview + 2K(QHD) capture is NOT dynamic, despite QHD outranking UHD in the enum', () => {
+    // QHD ordinal (5) > UHD ordinal (4), but 2560 < 3840 -- width must win.
+    expect(isDynamic(CameraResolution.UHD, CameraResolution.QHD)).toBe(false);
+  });
+
+  it('equal resolutions are NOT dynamic', () => {
+    expect(isDynamic(CameraResolution.QHD, CameraResolution.QHD)).toBe(false);
+  });
+});
+
+/**
+ * Found by the simulator: a camera lost mid-scan (track ended) went unnoticed
+ * -- the shutter stayed up over the last frame -- and a Semi-auto scan whose
+ * scanner was deleted (destroy(), close()) never settled its start().
+ */
+describe('Scanner.start() -- ends when its camera does', () => {
+  /** A real Scanner on a fake camera, scanning in Semi-auto. */
+  function semiAutoScanner() {
+    const listeners: Record<string, Array<() => void>> = {};
+    const track: any = {
+      stop: jest.fn(),
+      enabled: true,
+      addEventListener: (type: string, listener: () => void) => (listeners[type] ??= []).push(listener),
+      /** What the browser does when the camera goes away. */
+      end: () => listeners.ended?.forEach(listener => listener()),
+    };
+    const videoFeed: any = {
+      srcObject: { getVideoTracks: () => [track], getTracks: () => [track] },
+      play: jest.fn().mockResolvedValue(undefined),
+      pause: jest.fn(),
+    };
+    const scanner = new Scanner({} as any, {
+      cameraFeed: videoFeed,
+      cameraType: CameraType.Front, // no start-up delay
+      captureMode: CaptureMode.SemiAuto,
+      recorderStrategy: RecorderStrategy.Disabled,
+    } as any);
+    return { scanner, track };
+  }
+
+  it('a camera lost mid-scan fails the scan: CameraNotAvailable', async () => {
+    const { scanner, track } = semiAutoScanner();
+    const scan = scanner.start();
+
+    track.end();
+
+    await expect(scan).rejects.toMatchObject({ code: ErrorCode.CameraNotAvailable });
+  });
+
+  it('delete() ends a running scan rather than leaving it pending', async () => {
+    const { scanner } = semiAutoScanner();
+    const scan = scanner.start();
+
+    scanner.delete();
+
+    await expect(scan).rejects.toMatchObject({ code: ErrorCode.RecognizerMissing });
+  });
+
+  it('pause() stops the scan clock: a paused scan does not time out', () => {
+    // Found by the simulator (live/pause): the second idle minute's pause and
+    // the scanner's own timeout fired together, and the timeout ended the scan
+    // from under the pause screen.
+    jest.useFakeTimers();
+    try {
+      const { scanner } = semiAutoScanner();
+      const s: any = scanner;
+      // The global timer: in this environment window.setTimeout is the mock
+      // window's own, which jest does not fake (in a browser they are one).
+      s.timeoutSchedule = setTimeout(() => (s.timedOut = true), 60000);
+
+      scanner.pause();
+      jest.advanceTimersByTime(61000);
+
+      expect(s.timedOut).toBe(false);
+    } finally {
+      jest.useRealTimers();
+    }
+  });
+
+  it('Live: a frame the engine could not download data for is reported, and the next waits', async () => {
+    // 6.0's on-demand engine answers DataUnavailable when a document or
+    // language file it needed did not arrive. The stream must carry on -- but
+    // not at frame rate, asking the same failing server again every frame.
+    jest.spyOn(Camera, 'getImageData').mockReturnValue({
+      imageData: { data: new Uint8ClampedArray(4), width: 1, height: 1 },
+    } as any);
+    const later = jest.spyOn(window, 'setTimeout').mockImplementation((() => 0) as any);
+    try {
+      const s: any = Object.create(Scanner.prototype);
+      Object.assign(s, {
+        recognizer: { processImage: jest.fn().mockResolvedValue(RecognizerState.DataUnavailable) },
+        videoFeed: {},
+        shouldStopScanning: false,
+        scanningPaused: false,
+        cancelled: false,
+        timedOut: false,
+        timeoutSchedule: 1, // the scan clock is already running
+        stop: jest.fn(),
+        onDataUnavailable: jest.fn(),
+      });
+
+      s.processFrame(); // settles only when the stream ends
+      await new Promise(r => setTimeout(r, 0));
+
+      expect(s.onDataUnavailable).toHaveBeenCalledTimes(1);
+      expect(s.stop).not.toHaveBeenCalled();
+      expect(later).toHaveBeenLastCalledWith(expect.any(Function), 2000);
+    } finally {
+      jest.restoreAllMocks();
+    }
+  });
+
+  it('a camera lost after the scan has finished changes nothing', async () => {
+    const { scanner, track } = semiAutoScanner();
+    const scan = scanner.start();
+    scanner.endScan(RecognizerState.Valid);
+
+    track.end();
+
+    await expect(scan).resolves.toBe(RecognizerState.Valid);
+  });
+});
diff --git a/src/core/lib/SessionRecorder.ts b/src/core/lib/SessionRecorder.ts
new file mode 100644
index 000000000..2c2dfd191
--- /dev/null
+++ b/src/core/lib/SessionRecorder.ts
@@ -0,0 +1,764 @@
+/**
+ * Low-cost session recording.
+ *
+ * The session video is evidence: it shows an operator (or an auditor) that a
+ * real person held a real document in front of a real camera. Nobody reads text
+ * off it, so it does not need the camera's resolution or frame rate -- and
+ * paying for those is what makes phones hot.
+ *
+ * The previous implementation handed the raw camera stream to `MediaRecorder`,
+ * so the encoder chewed through every pixel of every frame the sensor produced:
+ * 1920x1080 at 30fps is 62 megapixels per second, in software (VP8), for the
+ * whole session, alongside the OCR engine competing for the same cores.
+ *
+ * This records a downscaled copy sampled at a few frames per second instead.
+ * The pixel rate drops by two orders of magnitude, which is the entire cost of
+ * video encoding -- bitrate only decides how big the file is, not how much work
+ * the CPU does to produce it.
+ *
+ * Two strategies, picked by what the browser can actually do:
+ *
+ *  - `CanvasEncode` -- a small canvas is fed to `MediaRecorder` through
+ *    `captureStream`, using the cheapest codec the browser offers. Produces a
+ *    normal video file.
+ *  - `Timelapse` -- no video encoder at all: JPEG stills muxed into Motion-JPEG
+ *    AVI by hand. Needs nothing but a canvas, so it works where `MediaRecorder`
+ *    is missing or refuses every codec, and it is the cheapest option available
+ *    on a device that is struggling.
+ */
+
+/**
+ * How the session is recorded.
+ */
+export enum RecorderStrategy {
+  /** Pick the best available at runtime. */
+  Auto = 'auto',
+  /** Downscaled canvas fed to `MediaRecorder`. */
+  CanvasEncode = 'canvas-encode',
+  /** JPEG stills muxed into Motion-JPEG AVI. No video encoder. */
+  Timelapse = 'timelapse',
+  /** Record nothing. */
+  Disabled = 'disabled',
+}
+
+/**
+ * Tuning for {@link SessionRecorder}. Every field has a defensible default;
+ * the defaults are what the SDK ships with.
+ */
+export interface SessionRecorderSettings {
+  /** Which strategy to use. Defaults to {@link RecorderStrategy.Auto}. */
+  strategy?: RecorderStrategy;
+  /**
+   * Long-edge width of the recorded copy, in pixels. Defaults to 640, which is
+   * enough to see a hand, a face and a document at arm's length.
+   *
+   * This is the dominant cost: encoder work scales with the pixel count, so
+   * doubling this roughly quadruples it.
+   */
+  width?: number;
+  /** Frames sampled per second. Defaults to 6. */
+  frameRate?: number;
+  /**
+   * Encoder bitrate for {@link RecorderStrategy.CanvasEncode}. Defaults to
+   * 1Mbps: a ceiling rather than a target, since the encoder spends only what
+   * the picture needs and a mostly-static scene stays well under it. At the
+   * default size and frame rate this is more than the picture can use, so it
+   * effectively removes the bitrate as a constraint on quality.
+   *
+   * This changes file size, not CPU -- see `width` and `frameRate` for that.
+   */
+  videoBitsPerSecond?: number;
+  /** JPEG quality for {@link RecorderStrategy.Timelapse}. Defaults to 0.6. */
+  quality?: number;
+  /**
+   * Hard stop, in milliseconds, so a session left open cannot grow without
+   * bound. Defaults to 3 minutes.
+   */
+  maxDurationMs?: number;
+}
+
+/**
+ * What the recorder produced.
+ */
+export interface SessionRecording {
+  /** The encoded video. Empty if nothing was recorded. */
+  blob: Blob;
+  /** The real MIME type of `blob` -- not assumed, whatever was negotiated. */
+  mimeType: string;
+  /** Strategy that produced it. */
+  strategy: RecorderStrategy;
+  /** Byte length of `blob`. */
+  bytes: number;
+  /** Frames actually written. */
+  frames: number;
+  /** Wall-clock milliseconds spent recording, excluding paused time. */
+  durationMs: number;
+  /** Recorded frame size. */
+  width: number;
+  height: number;
+  /**
+   * Total milliseconds spent on the main thread drawing frames. The recorder's
+   * own measurable cost; the encoder's cost lives on a different thread.
+   */
+  drawMs: number;
+}
+
+const DEFAULTS = {
+  width: 640,
+  frameRate: 6,
+  videoBitsPerSecond: 1000000,
+  quality: 0.6,
+  maxDurationMs: 180000,
+};
+
+/**
+ * Candidate MIME types, cheapest first.
+ *
+ * H.264 comes first because it is the one codec with a hardware encoder on
+ * essentially every phone shipped this decade -- the encode happens on a fixed
+ * function block instead of the CPU, which is the difference between a warm
+ * phone and a hot one. VP8 is software on most builds but universally
+ * available, so it backs H.264 up. VP9 is deliberately last of the real
+ * choices: it is the most expensive to encode of the lot.
+ */
+const MIME_CANDIDATES = [
+  'video/mp4;codecs=avc1.42E01E',
+  'video/mp4',
+  'video/webm;codecs=h264',
+  'video/webm;codecs=vp8',
+  'video/webm;codecs=vp9',
+  'video/webm',
+];
+
+export class SessionRecorder {
+  private settings: Required<SessionRecorderSettings>;
+  private source: HTMLVideoElement;
+
+  private canvas: HTMLCanvasElement | null = null;
+  private context: CanvasRenderingContext2D | null = null;
+
+  private recorder: MediaRecorder | null = null;
+  private captured: MediaStream | null = null;
+  private chunks: Blob[] = [];
+
+  /** JPEG stills, for {@link RecorderStrategy.Timelapse}. */
+  private stills: ArrayBuffer[] = [];
+  /** Guards against a slow `toBlob` overlapping the next sample. */
+  private encodingStill: boolean = false;
+
+  private timer: any = null;
+  private strategy: RecorderStrategy = RecorderStrategy.Disabled;
+  private mimeType: string = '';
+  private running: boolean = false;
+  private width: number = 0;
+  private height: number = 0;
+
+  private frames: number = 0;
+  private drawMs: number = 0;
+  private activeMs: number = 0;
+  private startedAt: number = 0;
+
+  private onVisibility: (() => void) | null = null;
+
+  constructor(source: HTMLVideoElement, settings: SessionRecorderSettings = {}) {
+    this.source = source;
+    this.settings = {
+      strategy: settings.strategy ?? RecorderStrategy.Auto,
+      width: settings.width ?? DEFAULTS.width,
+      frameRate: settings.frameRate ?? DEFAULTS.frameRate,
+      videoBitsPerSecond: settings.videoBitsPerSecond ?? DEFAULTS.videoBitsPerSecond,
+      quality: settings.quality ?? DEFAULTS.quality,
+      maxDurationMs: settings.maxDurationMs ?? DEFAULTS.maxDurationMs,
+    };
+  }
+
+  /**
+   * The MIME type `MediaRecorder` will accept, or an empty string if it will
+   * not accept any -- which is the signal to fall back to the timelapse.
+   *
+   * Nothing here is inferred from the browser's user agent: support is asked
+   * for directly, so a browser that gains or loses a codec is handled without a
+   * code change.
+   */
+  public static negotiateMimeType(): string {
+    if (typeof MediaRecorder === 'undefined' || !MediaRecorder.isTypeSupported) {
+      return '';
+    }
+
+    for (const candidate of MIME_CANDIDATES) {
+      if (MediaRecorder.isTypeSupported(candidate)) {
+        return candidate;
+      }
+    }
+
+    return '';
+  }
+
+  /** Whether anything can be recorded at all. */
+  public static isSupported(): boolean {
+    return (
+      typeof document !== 'undefined' &&
+      typeof HTMLCanvasElement !== 'undefined' &&
+      typeof HTMLCanvasElement.prototype.toBlob === 'function'
+    );
+  }
+
+  /** The strategy chosen for this recorder. Only meaningful after `start()`. */
+  public get chosenStrategy(): RecorderStrategy {
+    return this.strategy;
+  }
+
+  /**
+   * Begins recording. Safe to call when already running.
+   *
+   * A failure to record is never a failure to scan: any problem downgrades to a
+   * cheaper strategy, and in the worst case to recording nothing at all.
+   */
+  public start(): void {
+    if (this.running) {
+      return;
+    }
+
+    if (this.settings.strategy === RecorderStrategy.Disabled || !SessionRecorder.isSupported()) {
+      this.strategy = RecorderStrategy.Disabled;
+      return;
+    }
+
+    if (!this.canvas) {
+      this.prepareCanvas();
+    }
+
+    if (!this.canvas || !this.context) {
+      this.strategy = RecorderStrategy.Disabled;
+      return;
+    }
+
+    if (this.strategy === RecorderStrategy.Disabled) {
+      this.strategy = this.chooseStrategy();
+    }
+
+    if (this.strategy === RecorderStrategy.CanvasEncode && !this.recorder) {
+      if (!this.startEncoder()) {
+        // The encoder refused mid-setup. The timelapse needs no encoder, so it
+        // can always take over.
+        this.strategy = RecorderStrategy.Timelapse;
+      }
+    }
+
+    if (this.strategy === RecorderStrategy.Disabled) {
+      return;
+    }
+
+    if (this.recorder) {
+      if (this.recorder.state === 'paused') {
+        this.recorder.resume();
+      } else if (this.recorder.state === 'inactive') {
+        // A timeslice keeps chunks arriving during the session rather than
+        // materialising the whole recording in one allocation at the end.
+        this.recorder.start(2000);
+      }
+    }
+
+    this.running = true;
+    this.startedAt = now();
+    this.startPump();
+    this.watchVisibility();
+  }
+
+  /**
+   * Stops sampling but keeps everything recorded so far, so `start()` can
+   * resume into the same recording. Used when the scan pauses for a retry.
+   */
+  public pause(): void {
+    if (!this.running) {
+      return;
+    }
+
+    this.running = false;
+    this.activeMs += now() - this.startedAt;
+    this.stopPump();
+
+    if (this.recorder && this.recorder.state === 'recording') {
+      this.recorder.pause();
+    }
+  }
+
+  /**
+   * Finishes the recording and returns it.
+   *
+   * Resolves with an empty recording rather than rejecting when there is
+   * nothing to hand back, so callers never need to special-case it.
+   */
+  public async stop(): Promise<SessionRecording> {
+    if (this.running) {
+      this.activeMs += now() - this.startedAt;
+    }
+
+    this.running = false;
+    this.stopPump();
+    this.unwatchVisibility();
+
+    let blob: Blob;
+
+    if (this.strategy === RecorderStrategy.CanvasEncode && this.recorder) {
+      blob = await this.finishEncoder();
+    } else if (this.strategy === RecorderStrategy.Timelapse) {
+      blob = this.muxMotionJpeg();
+    } else {
+      blob = new Blob([], { type: '' });
+    }
+
+    this.release();
+    this.chunks = [];
+    this.stills = [];
+
+    return {
+      blob,
+      mimeType: blob.type || this.mimeType,
+      strategy: this.strategy,
+      bytes: blob.size,
+      frames: this.frames,
+      durationMs: Math.round(this.activeMs),
+      width: this.width,
+      height: this.height,
+      drawMs: Math.round(this.drawMs * 100) / 100,
+    };
+  }
+
+  /** Frees the canvas, encoder and buffered frames. */
+  public dispose(): void {
+    this.stopPump();
+    this.unwatchVisibility();
+
+    if (this.recorder && this.recorder.state !== 'inactive') {
+      try {
+        this.recorder.stop();
+      } catch {
+        // Already tearing down; nothing useful to do with the error.
+      }
+    }
+
+    this.release();
+    this.chunks = [];
+    this.stills = [];
+  }
+
+  /**
+   * Sizes the offscreen canvas to the settings' width, preserving the camera's
+   * aspect ratio and keeping both edges even -- odd dimensions are rejected or
+   * silently corrected by some H.264 encoders.
+   */
+  private prepareCanvas(): void {
+    const sourceWidth = this.source.videoWidth || 1280;
+    const sourceHeight = this.source.videoHeight || 720;
+    const scale = Math.min(1, this.settings.width / sourceWidth);
+
+    this.width = even(Math.round(sourceWidth * scale));
+    this.height = even(Math.round(sourceHeight * scale));
+
+    const canvas = document.createElement('canvas');
+    canvas.width = this.width;
+    canvas.height = this.height;
+
+    // `alpha: false` lets the compositor skip the alpha channel, and
+    // `desynchronized` allows the draw to bypass a compositing round-trip.
+    // Both are hints; browsers that ignore them behave exactly as before.
+    const context = canvas.getContext('2d', {
+      alpha: false,
+      desynchronized: true,
+    }) as CanvasRenderingContext2D | null;
+
+    if (!context) {
+      return;
+    }
+
+    // Downscaling is the only drawing this class does, and the smoothing
+    // quality is the one knob that changes its cost. Low is right: the output
+    // is a thumbnail-sized evidence clip.
+    context.imageSmoothingEnabled = true;
+    context.imageSmoothingQuality = 'low';
+
+    this.canvas = canvas;
+    this.context = context;
+  }
+
+  private chooseStrategy(): RecorderStrategy {
+    if (this.settings.strategy !== RecorderStrategy.Auto) {
+      return this.settings.strategy;
+    }
+
+    return SessionRecorder.negotiateMimeType()
+      ? RecorderStrategy.CanvasEncode
+      : RecorderStrategy.Timelapse;
+  }
+
+  /**
+   * Wires the canvas to a `MediaRecorder`.
+   *
+   * @returns whether the encoder is ready.
+   */
+  private startEncoder(): boolean {
+    if (!this.canvas || typeof this.canvas.captureStream !== 'function') {
+      return false;
+    }
+
+    this.mimeType = SessionRecorder.negotiateMimeType();
+
+    if (!this.mimeType) {
+      return false;
+    }
+
+    try {
+      this.captured = this.canvas.captureStream(this.settings.frameRate);
+
+      this.recorder = new MediaRecorder(this.captured, {
+        mimeType: this.mimeType,
+        videoBitsPerSecond: this.settings.videoBitsPerSecond,
+      });
+
+      this.recorder.ondataavailable = event => {
+        if (event.data && event.data.size > 0) {
+          this.chunks.push(event.data);
+        }
+      };
+
+      return true;
+    } catch (error) {
+      console.warn('SessionRecorder: encoder unavailable, falling back', error);
+      this.captured = null;
+      this.recorder = null;
+      return false;
+    }
+  }
+
+  private finishEncoder(): Promise<Blob> {
+    return new Promise(resolve => {
+      const recorder = this.recorder;
+
+      if (!recorder || recorder.state === 'inactive') {
+        resolve(new Blob(this.chunks, { type: this.mimeType }));
+        return;
+      }
+
+      recorder.onstop = () => resolve(new Blob(this.chunks, { type: this.mimeType }));
+
+      try {
+        recorder.stop();
+      } catch (error) {
+        console.warn('SessionRecorder: stop failed', error);
+        resolve(new Blob(this.chunks, { type: this.mimeType }));
+      }
+    });
+  }
+
+  /**
+   * Samples on a timer rather than `requestAnimationFrame`.
+   *
+   * rAF is tied to the display's refresh rate, so it would fire ~8x more often
+   * than needed only to have most calls discarded, and it stops entirely when
+   * the page is hidden. A timer asks for exactly the rate wanted.
+   */
+  private startPump(): void {
+    this.stopPump();
+
+    const interval = Math.max(1, Math.round(1000 / this.settings.frameRate));
+    this.timer = setInterval(() => this.sample(), interval);
+  }
+
+  private stopPump(): void {
+    if (this.timer !== null) {
+      clearInterval(this.timer);
+      this.timer = null;
+    }
+  }
+
+  private sample(): void {
+    if (!this.running || !this.context || !this.canvas) {
+      return;
+    }
+
+    if (this.activeMs + (now() - this.startedAt) >= this.settings.maxDurationMs) {
+      this.pause();
+      return;
+    }
+
+    // A hidden page has a suspended camera, so the frame would be a duplicate
+    // of the last one; and `toBlob` on a hidden page is heavily throttled.
+    if (typeof document !== 'undefined' && document.visibilityState === 'hidden') {
+      return;
+    }
+
+    // `readyState < 2` means no frame has been decoded yet, and drawing then
+    // paints a blank rectangle into the evidence.
+    if (this.source.readyState < 2) {
+      return;
+    }
+
+    const before = now();
+    this.context.drawImage(this.source, 0, 0, this.width, this.height);
+    this.drawMs += now() - before;
+    this.frames++;
+
+    if (this.strategy === RecorderStrategy.Timelapse) {
+      this.captureStill();
+    }
+  }
+
+  /**
+   * Encodes the current canvas as a JPEG for the timelapse.
+   *
+   * `toBlob` is asynchronous and hands the work to the browser's image encoder
+   * off the main thread. If it has not finished by the next tick the frame is
+   * dropped rather than queued -- a backlog would cost more than the frame is
+   * worth.
+   */
+  private captureStill(): void {
+    if (!this.canvas || this.encodingStill) {
+      return;
+    }
+
+    this.encodingStill = true;
+
+    this.canvas.toBlob(
+      async blob => {
+        this.encodingStill = false;
+
+        if (!blob) {
+          return;
+        }
+
+        try {
+          this.stills.push(await blob.arrayBuffer());
+        } catch {
+          // A dropped still costs one frame of evidence, nothing more.
+        }
+      },
+      'image/jpeg',
+      this.settings.quality,
+    );
+  }
+
+  /**
+   * Packs the collected JPEGs into a Motion-JPEG AVI.
+   *
+   * AVI is the one container simple enough to write correctly by hand in a few
+   * dozen lines -- it is a flat list of frames plus an index, with no timestamp
+   * interleaving or codec-specific headers to get wrong. Every player and every
+   * server-side transcoder reads MJPEG/AVI.
+   */
+  private muxMotionJpeg(): Blob {
+    if (!this.stills.length) {
+      return new Blob([], { type: '' });
+    }
+
+    const frames = this.stills;
+    const count = frames.length;
+    const payload = frames.reduce((total, frame) => total + frame.byteLength + pad(frame) + 8, 0);
+    const largest = frames.reduce((max, frame) => Math.max(max, frame.byteLength), 0);
+
+    const HDRL = 4 + 8 + 56 + 8 + 4 + 8 + 56 + 8 + 40;
+    const idx1 = 8 + count * 16;
+    const movi = 8 + 4 + payload;
+    const total = 8 + 4 + 8 + HDRL + movi + idx1;
+
+    const buffer = new ArrayBuffer(total);
+    const view = new DataView(buffer);
+    const bytes = new Uint8Array(buffer);
+    const writer = new RiffWriter(view, bytes);
+
+    const rate = this.settings.frameRate;
+    const microsPerFrame = Math.round(1000000 / rate);
+
+    writer.fourcc('RIFF');
+    writer.u32(total - 8);
+    writer.fourcc('AVI ');
+
+    // -- hdrl: stream declarations ------------------------------------------
+    writer.fourcc('LIST');
+    writer.u32(HDRL);
+    writer.fourcc('hdrl');
+
+    writer.fourcc('avih');
+    writer.u32(56);
+    writer.u32(microsPerFrame);
+    writer.u32(Math.round((largest * rate) / 1)); // dwMaxBytesPerSec
+    writer.u32(0); // dwPaddingGranularity
+    writer.u32(0x10); // AVIF_HASINDEX
+    writer.u32(count); // dwTotalFrames
+    writer.u32(0); // dwInitialFrames
+    writer.u32(1); // dwStreams
+    writer.u32(largest); // dwSuggestedBufferSize
+    writer.u32(this.width);
+    writer.u32(this.height);
+    writer.zero(16); // dwReserved[4]
+
+    writer.fourcc('LIST');
+    writer.u32(4 + 8 + 56 + 8 + 40);
+    writer.fourcc('strl');
+
+    writer.fourcc('strh');
+    writer.u32(56);
+    writer.fourcc('vids');
+    writer.fourcc('MJPG');
+    writer.u32(0); // dwFlags
+    writer.u16(0); // wPriority
+    writer.u16(0); // wLanguage
+    writer.u32(0); // dwInitialFrames
+    writer.u32(1); // dwScale
+    writer.u32(rate); // dwRate -> rate/scale = fps
+    writer.u32(0); // dwStart
+    writer.u32(count); // dwLength
+    writer.u32(largest); // dwSuggestedBufferSize
+    writer.u32(10000); // dwQuality
+    writer.u32(0); // dwSampleSize
+    writer.u16(0); // rcFrame.left
+    writer.u16(0); // rcFrame.top
+    writer.u16(this.width); // rcFrame.right
+    writer.u16(this.height); // rcFrame.bottom
+
+    writer.fourcc('strf');
+    writer.u32(40);
+    writer.u32(40); // biSize
+    writer.i32(this.width);
+    writer.i32(this.height);
+    writer.u16(1); // biPlanes
+    writer.u16(24); // biBitCount
+    writer.fourcc('MJPG'); // biCompression
+    writer.u32(this.width * this.height * 3); // biSizeImage
+    writer.u32(0); // biXPelsPerMeter
+    writer.u32(0); // biYPelsPerMeter
+    writer.u32(0); // biClrUsed
+    writer.u32(0); // biClrImportant
+
+    // -- movi: the frames ----------------------------------------------------
+    writer.fourcc('LIST');
+    writer.u32(4 + payload);
+    writer.fourcc('movi');
+
+    const moviStart = writer.offset - 4; // index offsets are relative to 'movi'
+    const index: Array<{ offset: number; size: number }> = [];
+
+    for (const frame of frames) {
+      const chunkStart = writer.offset;
+      writer.fourcc('00dc');
+      writer.u32(frame.byteLength);
+      writer.raw(new Uint8Array(frame));
+      writer.zero(pad(frame));
+      index.push({ offset: chunkStart - moviStart, size: frame.byteLength });
+    }
+
+    // -- idx1: seek table ----------------------------------------------------
+    writer.fourcc('idx1');
+    writer.u32(count * 16);
+
+    for (const entry of index) {
+      writer.fourcc('00dc');
+      writer.u32(0x10); // AVIIF_KEYFRAME -- every MJPEG frame is a keyframe
+      writer.u32(entry.offset);
+      writer.u32(entry.size);
+    }
+
+    this.mimeType = 'video/x-msvideo';
+
+    return new Blob([buffer], { type: this.mimeType });
+  }
+
+  /**
+   * Pauses sampling while the page is hidden.
+   *
+   * Backgrounding is common mid-scan -- a notification, a call -- and the
+   * camera is suspended then anyway, so there is nothing to record and no
+   * reason to keep waking the CPU.
+   */
+  private watchVisibility(): void {
+    if (this.onVisibility || typeof document === 'undefined') {
+      return;
+    }
+
+    this.onVisibility = () => {
+      if (document.visibilityState === 'hidden' && this.running) {
+        this.stopPump();
+      } else if (document.visibilityState === 'visible' && this.running) {
+        this.startPump();
+      }
+    };
+
+    document.addEventListener('visibilitychange', this.onVisibility);
+  }
+
+  private unwatchVisibility(): void {
+    if (this.onVisibility && typeof document !== 'undefined') {
+      document.removeEventListener('visibilitychange', this.onVisibility);
+    }
+
+    this.onVisibility = null;
+  }
+
+  private release(): void {
+    if (this.captured) {
+      this.captured.getTracks().forEach(track => track.stop());
+      this.captured = null;
+    }
+
+    this.recorder = null;
+    this.canvas = null;
+    this.context = null;
+  }
+}
+
+/** Rounds up to an even number; H.264 dislikes odd dimensions. */
+function even(value: number): number {
+  const floored = Math.max(2, Math.round(value));
+  return floored % 2 === 0 ? floored : floored + 1;
+}
+
+/** RIFF chunks are word-aligned, so odd-sized payloads carry a pad byte. */
+function pad(frame: ArrayBuffer): number {
+  return frame.byteLength % 2;
+}
+
+function now(): number {
+  return typeof performance !== 'undefined' && performance.now ? performance.now() : Date.now();
+}
+
+/**
+ * Sequential little-endian writer for the AVI muxer.
+ */
+class RiffWriter {
+  public offset: number = 0;
+
+  constructor(
+    private view: DataView,
+    private bytes: Uint8Array,
+  ) {}
+
+  fourcc(value: string): void {
+    for (let i = 0; i < 4; i++) {
+      this.view.setUint8(this.offset++, value.charCodeAt(i));
+    }
+  }
+
+  u32(value: number): void {
+    this.view.setUint32(this.offset, value >>> 0, true);
+    this.offset += 4;
+  }
+
+  i32(value: number): void {
+    this.view.setInt32(this.offset, value, true);
+    this.offset += 4;
+  }
+
+  u16(value: number): void {
+    this.view.setUint16(this.offset, value & 0xffff, true);
+    this.offset += 2;
+  }
+
+  raw(value: Uint8Array): void {
+    this.bytes.set(value, this.offset);
+    this.offset += value.byteLength;
+  }
+
+  zero(count: number): void {
+    this.offset += count;
+  }
+}
