{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "allowUnreachableCode": false,
    "declaration": false,
    "experimentalDecorators": true,
    "lib": ["dom", "esnext"],
    "skipLibCheck": true,
    "moduleResolution": "node",
    "module": "esnext",
    "target": "es2020",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "jsx": "react",
    "jsxFactory": "h",
    "paths": {
      "@assets/*": ["./src/ui/assets/*"],
      "@images/*": ["./src/ui/assets/images/*"],
      "@animations/*": ["./src/ui/assets/animations/*"],
      "@utils/*": ["./src/utils/*"],
      "@style/*": ["./src/ui/global/*"],
      "@audio/*": ["./src/ui/assets/audio/*"],
    },
  },
  "include": ["./src", "./types/jsx.d.ts"],
  "exclude": ["node_modules"],
}
